mutate(total = na_if(total, 0))
View(censor_summary)
world_data <- left_join(world, censor_summary, by = c("iso_a2" = "iso_a2_censor"))
anti_join(censor_summary, world_orig, by = c("iso_a2_censor" = "iso_a2"))
world_data <- world_data %>%
mutate(bucket = case_when(
total >= 21  ~ "21+",
total >= 6  ~ "6-20",
total >= 2   ~ "2-5",
total >= 1   ~ "1"
))
world_data$bucket <- factor(world_data$bucket,
levels = c("21+", "6-20", "2-5", "1"))
unique(world_data$admin)
total_global <- censor_summary %>%
summarize(total_restrictions = sum(total, na.rm = TRUE)) %>%
pull(total_restrictions)
south_asia_codes <- c("IN", "PK", "BD", "LK", "NP", "BT", "MV", "AF")
total_south_asia <- censor_summary %>%
filter(iso_a2_censor %in% south_asia_codes) %>%
summarize(total_restrictions = sum(total, na.rm = TRUE)) %>%
pull(total_restrictions)
total_south_asia / total_global
bubble_data <- world_data %>%
filter(!is.na(total) & total >= 1) %>%
mutate(size_scaled = sqrt(total)*3)
bubble_coords <- bubble_data %>%
st_centroid() %>%
mutate(
X = st_coordinates(.)[,1],
Y = st_coordinates(.)[,2]
) %>%
st_drop_geometry()
View(bubble_coords)
bubble_coords <- bubble_coords[1:5,]
ggplot() +
geom_sf(data = world_data, aes(fill = total), color = "black") +
geom_point(data=bubble_coords,aes(x = X, y = Y), size = bubble_coords$size_scaled,
shape = 21,               # allows fill + border
fill = "bisque1",         # bubble fill color
color = "black",          # border color
stroke = 0.5)+
# geom_sf(
#   data = world_data,
#   aes(size = size_scaled),
#   color = "black",
#   fill = "bisque1",
#   shape = 21,
#   stroke = .5
# ) +
# scale_size_continuous(
#   range = c(3, 15)
# ) +
# scale_fill_manual(
#   values = c(
#     "21+"   = "#800026",
#     "6-20"  = "#E31A1C",
#     "2-5"   = "#FC4E2A",
#     "1"    = "#FD8D3C"
#   ),
#   na.value = "gray90",
#   name = "Number of internet restrictions"
# ) +
coord_sf(crs = st_crs(4326)) +
labs(
title = "India dominates internet censorships imposed in 2021–2024",
subtitle = "Number of internet restrictions imposed in 2021-2024 in South Asia by country",
caption = "South Asia accounted for 53.16% of global internet shutdowns instituted in 2021-2024 Source: Surfshark"
) +
geom_sf_text(
data = world_data %>% filter(!is.na(total) & total >= 1),
aes(label = admin),
size = 3,
color = "black"
) +
theme_void() +
guides(size = "none")
load_and_clean <- function(sheet_name, year, range) {
tab <- read_excel('censor.xlsx', sheet = sheet_name, skip = 1, range = range)
colnames(tab)[1:14] <- new_col_names
#tab$iso_a2_censor[tab$iso_a2_censor == "J&K"] <- "IN"
tab <- tab[, 1:14]
tab$current <- as.character(tab$current)
tab$year <- year
return(tab)
}
censor1 <- load_and_clean("2021", 2021,"A2:Z40")
censor2 <- load_and_clean("2022", 2022,"A2:Z34")
censor3 <- load_and_clean("2023", 2023,"A2:Z38")
censor4 <- load_and_clean("2024", 2024,"A2:Z40")
censor <- bind_rows(censor1, censor2, censor3, censor4)
censor_in_jk <- censor %>%
filter(iso_a2_censor %in% c("IN", "J&K")) %>%
group_by(year, iso_a2_censor) %>%
summarize(total_restrictions = sum(num_restrictions, na.rm = TRUE), .groups = "drop")
censor_in_jk$iso_a2_censor <- factor(
censor_in_jk$iso_a2_censor,
levels = c("J&K", "IN")
)
ggplot(censor_in_jk, aes(x = year, y = total_restrictions, color = iso_a2_censor)) +
geom_line(size = 1.2) +
geom_point(size = 3) +
scale_x_continuous(breaks = 2021:2024) +
scale_color_manual(
name = "Region",
values = c("IN" = "#FF9933", "J&K" = "#B22222"),  # Customize colors
labels = c("IN" = "Rest of India", "J&K" = "Jammu & Kashmir")
) +
labs(
title = "Jammu & Kashmir in 2021 at the center of India's recent crackdown on internet freedom",
subtitle = "Number of internet restrictions imposed by year in Jammu & Kashmir vs. all other Indian states and territories",
x = NULL,
y = "Censorships",
caption = "Jammu & Kashmir is a union territory of India; it is directly administed by the central Indian government Source: Surfshark"
) +
theme_minimal(base_size = 13) +
theme(
panel.grid.major.x = element_blank(),
panel.grid.minor.x = element_blank(),
legend.title = element_text(size = 12),
legend.text = element_text(size = 11)
)
#VIS 3
driver_cols <- c("protest", "politics",'election','internet_law')
censor_bar <- censor %>%
filter(iso_a2_censor %in% c("IN", "J&K", "BD", "PK",'AF','LK')) %>%
pivot_longer(cols = all_of(driver_cols), names_to = "driver", values_to = "value") %>%
group_by(iso_a2_censor, driver) %>%
summarize(count = sum(value, na.rm = TRUE), .groups = "drop")
View(censor_bar)
# Factor levels for order
censor_bar$iso_a2_censor <- factor(
censor_bar$iso_a2_censor,
levels = c("J&K", "IN", "PK", "BD",'LK','AF')
)
censor_bar$driver <- factor(
censor_bar$driver,
levels = c("internet_law", "election", "protest",'politics')
)
# Plot
ggplot(censor_bar, aes(x = iso_a2_censor, y = count, fill = driver)) +
geom_bar(stat = "identity", position = "stack", width = 0.7) +
scale_fill_manual(
name = "Censorship driver",
values = c("politics" = "coral4", "protest" = "indianred3", "election" = "salmon1",'internet_law'='rosybrown1'),
labels = c("politics" = "Political turmoil", "protest" = "Protests", "election" = "Elections",'internet_law'='Internet law')
) +
scale_x_discrete(labels = c("J&K" = "Jammu & Kashmir", "IN" = "Rest of India", "PK" = "Pakistan", "BD" = "Bangladesh",'LK'="Sri Lanka",'AF'='Afghanistan')) +
labs(
title = "Political turmoil drives internet censorship in Kashmir and Pakistan whereas protests instigate censorship in rest of India",
subtitle = "Count of internet censorships imposed in South Asian countries by cause from 2021 to 2024",
x = NULL,
y = "censorships",
caption = "Source: Surfshark"
) +
theme_minimal() +
theme(
panel.grid.major.x = element_blank(),
panel.grid.minor.x = element_blank(),
legend.title = element_text(size = 11),
legend.text = element_text(size = 10)
) +   coord_cartesian(ylim = c(0, 120))
