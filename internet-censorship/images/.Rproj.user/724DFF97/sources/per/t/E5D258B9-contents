# Function to load and clean one sheet
load_censor_data <- function(sheet, skip_rows) {
  censor <- read_excel('censor.xlsx', sheet = sheet, skip = skip_rows)
  last_5_col_names <- colnames(censor)[(ncol(censor) - 4):ncol(censor)]
  colnames(censor) <- c(new_col_names, last_5_col_names)
  #censor$iso_a2_censor[censor$iso_a2_censor == "J&K"] <- "IN"
  censor$year <- sheet
  return(censor)
}

# Load and combine all years
censor_all <- bind_rows(
  lapply(names(sheet_info), function(sheet) {
    load_censor_data(sheet, sheet_info[[sheet]])
  })
)























































